# Puerto de escucha del servidor
PORT=3000

# Cadena de conexión para la base de datos PostgreSQL de desarrollo
DATABASE_URL=postgresql://postgres:root@localhost:5432/talenthub_dev

# Cadena de conexión para la base de datos PostgreSQL de pruebas de integración
TEST_DATABASE_URL=postgresql://postgres:root@localhost:5432/talenthub_dev_test

# Selección del adaptador de persistencia para Candidates:
# 'sql' para PostgreSQL con pg | Dejar vacío o no definir para usar InMemory
CANDIDATES_ADAPTER=sql