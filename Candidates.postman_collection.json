              "raw": "{\n  \"name\": \"Valeria Castro Actualizada\",\n  \"email\": \"valeria.castro@example.com\",\n  \"city\": \"Quito\",\n  \"experienceYears\": 4,\n  \"skills\": [\"TypeScript\", \"SQL\", \"Docker\"]\n}"
